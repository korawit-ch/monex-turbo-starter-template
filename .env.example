# ============================================
# DATABASE (apps/db, packages/prisma)
# ============================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=monex-turbo-starter-template-db
DB_PORT=5433
DB_CONTAINER_NAME=monex-turbo-starter-template-db

# Prisma connection string (auto-constructed from DB_* variables)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}?schema=public"

# ============================================
# BACKEND APIs
# ============================================
# Voting API Port
VOTING_API_PORT=3001

# Registry API Port
REGISTRY_API_PORT=3003

# ============================================
# FRONTEND APPS
# ============================================
# API URL for Voting Web to call Voting API
NEXT_PUBLIC_VOTING_API_URL="http://localhost:3001"

# API URL for Registry Web to call Registry API
NEXT_PUBLIC_REGISTRY_API_URL="http://localhost:3003"

# ============================================
# GENERAL
# ============================================
# Node environment
NODE_ENV=development
