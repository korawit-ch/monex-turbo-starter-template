{
  "name": "@repo/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./utils": "./src/utils.ts",
    "./styles.css": "./dist/index.css",
    "./*": "./dist/*.js"
  },
  "license": "MIT",
  "scripts": {
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "build:components": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "dev:components": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^3.9.1",
    "react": "^19",
    "react-hook-form": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@repo/design-system": "*",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@repo/vitest-config": "*",
    "@tailwindcss/cli": "^4.1.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.1.0",
    "eslint": "^9.39.1",
    "jsdom": "^28.1.0",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "tailwindcss": "^4.1.5",
    "typescript": "5.9.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "zod": "^3.25.76"
  }
}
