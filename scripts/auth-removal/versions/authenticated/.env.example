# ============================================
# DATABASE (apps/db, packages/prisma)
# ============================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=monex-turbo-starter-template-db
DB_PORT=5433
DB_CONTAINER_NAME=monex-turbo-starter-template-db

# Prisma connection string (auto-constructed from DB_* variables)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}?schema=public"

# ============================================
# BACKEND APIs
# ============================================
# Bind Nest privately for the browser-facing BFF topology
API_PORT=3001
API_HOST="127.0.0.1"
API_INTERNAL_URL="http://127.0.0.1:3001"

# Browser origin used for mutation origin checks
WEB_ORIGIN="http://localhost:3000"

# Authentication (replace both secrets; each must contain at least 32 bytes)
AUTH_COOKIE_SECRET="replace-with-an-independent-32-byte-cookie-secret"
AUTH_JWT_SECRET="replace-with-an-independent-32-byte-jwt-secret-value"
AUTH_COOKIE_DOMAIN=""
AUTH_JWT_ISSUER="monex-api"
AUTH_JWT_AUDIENCE="monex-web"
AUTH_ACCESS_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=2592000

# Development seed account; never reuse these credentials in production
AUTH_SEED_EMAIL="admin@example.com"
AUTH_SEED_PASSWORD="local-change-me"

# ============================================
# GENERAL
# ============================================
# Node environment
NODE_ENV=development
