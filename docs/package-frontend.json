{
  "name": "monex-turbo-starter-template-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Frontend monorepo with Next.js apps",
  "scripts": {
    "postinstall": "node scripts/setup-env.js",
    "predev": "node scripts/distribute-env.js",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint && prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "env:setup": "node scripts/setup-env.js",
    "env:distribute": "node scripts/distribute-env.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.2.5",
    "turbo": "^2.6.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@10.2.3",
  "workspaces": ["apps/*", "packages/*"],
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md,css}": ["prettier --write"]
  }
}
